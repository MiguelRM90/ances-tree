{
  "name": "ancestree",
  "version": "0.1.0",
  "description": "Local-first genealogy PWA built with 100% Vanilla JS & Web Components. Zero runtime dependencies, custom streaming ZIP & GEDCOM 5.5.1 engines, File System Access API + OPFS.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiguelRM90/ances-tree.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "web-test-runner \"test/**/*.test.js\" --node-resolve",
    "test:watch": "web-test-runner \"test/**/*.test.js\" --node-resolve --watch",
    "lint": "eslint src test",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "stress:generate": "node scripts/generate-family.mjs --people 10000 --out ./stress-10k",
    "stress:bench": "node scripts/benchmark.mjs ./stress-10k"
  },
  "devDependencies": {
    "@open-wc/testing": "4.0.0",
    "@web/test-runner": "0.19.0",
    "eslint": "9.15.0",
    "eslint-plugin-wc": "2.2.0",
    "prettier": "3.3.3",
    "vite": "5.4.11"
  },
  "dependencies": {},
  "packageManager": "pnpm@12.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
